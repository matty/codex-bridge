#!/usr/bin/env bash
# codex-imagegen — generate or edit an image with OpenAI gpt-image-2 through the
# Codex CLI, using your existing `codex login` (ChatGPT plan). No API key needed.
#
# Usage:
#   codex-imagegen "<prompt>" <output.png> [options]
#
# Options:
#   --size WxH        1024x1024 (default) | 1536x1024 | 1024x1536 | 1280x640 | 3840x2160
#                     Custom sizes: longest edge <= 3840, both edges multiples of
#                     16, ratio <= 3:1, total pixels 655,360-8,294,400.
#   --ref <file>      Source/reference image. Repeatable (max 4). Passing a --ref
#                     turns this into an EDIT: describe the change in the prompt.
#   --model <name>    Model that drives the image tool (default: the 'image'
#                     route in lib/routes.sh)
#   --effort <lvl>    Reasoning effort for that model (default: the 'image' route)
#   --timeout <sec>   Abort after N seconds (default: 600)
#   --start-timeout <sec>  Abort if Codex opens no session in N seconds (default: 60)
#
# Examples:
#   codex-imagegen "flat vector rocket icon, blue #2563EB, minimal" ./rocket.png
#   codex-imagegen "make the sky sunset orange, keep everything else identical" \
#       ./out.png --ref ./original.png
#
# Output: absolute path of the written PNG on stdout.
# Exit:   0 ok | 1 usage/precondition | 2 generation failed
#         3 the image call left out the reference, nothing saved | 124 timed out.

set -uo pipefail

err() { printf 'codex-imagegen: %s\n' "$*" >&2; }

# shellcheck source=../lib/routes.sh
. "$(cd "$(dirname "$0")/../lib" && pwd)/routes.sh"

# mtime <file> — GNU stat first (Linux), BSD stat fallback (macOS)
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

usage() {
  sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# abspath <file> — absolute path with the directory normalised, so two spellings
# of one file compare equal. Backslashes become slashes for Git Bash.
abspath() {
  local p="${1//\\//}"
  printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

[ $# -ge 2 ] || usage

PROMPT="$1"; shift
OUTPUT="$1"; shift
SIZE=""
MODEL=""
EFFORT=""
TIMEOUT=600
START_TIMEOUT=60
REFS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --size)    SIZE="${2:-}"; shift 2 ;;
    --model)   MODEL="${2:-}"; shift 2 ;;
    --effort)  EFFORT="${2:-}"; shift 2 ;;
    --timeout) TIMEOUT="${2:-}"; shift 2 ;;
    --start-timeout) START_TIMEOUT="${2:-}"; shift 2 ;;
    --ref)     REFS+=("${2:-}"); shift 2 ;;
    -h|--help) usage ;;
    *) err "unknown argument: $1"; usage ;;
  esac
done

ROUTED="$(route_lookup image)"
[ -n "$MODEL" ]  || MODEL="${ROUTED% *}"
[ -n "$EFFORT" ] || EFFORT="${ROUTED#* }"
if ! valid_effort "$EFFORT"; then
  err "invalid effort '$EFFORT' ($EFFORTS)"; exit 1
fi

[ -n "$PROMPT" ] || { err "prompt is empty"; exit 1; }
[ -n "$OUTPUT" ] || { err "output path is empty"; exit 1; }

if [ "${#REFS[@]}" -gt 4 ]; then
  err "at most 4 --ref images are supported (got ${#REFS[@]})"
  exit 1
fi

# --- Preconditions -----------------------------------------------------------
if ! command -v codex >/dev/null 2>&1; then
  err "codex CLI not found on PATH. Install it ('npm i -g @openai/codex' or 'brew install codex') then run 'codex login'."
  exit 1
fi

if ! codex login status >/dev/null 2>&1; then
  err "codex is not logged in. Run 'codex login' in a terminal, then retry. (ChatGPT Plus/Pro/Team works; no API key needed.)"
  exit 1
fi

# --- Resolve paths -----------------------------------------------------------
OUTPUT="${OUTPUT//\\//}"
OUTDIR="$(dirname "$OUTPUT")"
BASENAME="$(basename "$OUTPUT")"
mkdir -p "$OUTDIR" || { err "cannot create output folder: $OUTDIR"; exit 1; }
OUTPUT="$(abspath "$OUTPUT")"

ABS_REFS=()
for r in "${REFS[@]:-}"; do
  [ -n "$r" ] || continue
  if [ ! -f "$r" ]; then
    err "reference image not found: $r"
    exit 1
  fi
  ABS="$(abspath "$r")"
  if [ "$ABS" = "$OUTPUT" ]; then
    err "output would overwrite its own reference: $r"
    exit 1
  fi
  ABS_REFS+=("$ABS")
done
N_REFS="${#ABS_REFS[@]}"

# --- Build the instruction for Codex -----------------------------------------
# Note: \$imagegen must reach Codex literally — it names Codex's built-in
# image-generation skill.
#
# Codex must not save anything. Told to save, it searched the shared
# generated_images folder, took the newest file and copied another run's picture,
# or could not work out how to save and generated again (up to 7 images for one
# output). This wrapper collects the image from the session's own folder instead.
COLLECT_RULE="Do not save, copy, move, list, search for or view any file, and do not call the tool again: the caller collects the image from your session. End your turn straight after the call."

if [ "$N_REFS" -gt 0 ]; then
  # The image tool only sees attachments when the call sets this parameter.
  INSTRUCTION="Use the \$imagegen image generation tool exactly once. This is an edit of the attached image(s), not a new image: pass num_last_images_to_include:${N_REFS} in that call so they reach the tool, and preserve everything the change does not mention. ${COLLECT_RULE} Change to make: ${PROMPT}"
else
  INSTRUCTION="Use the \$imagegen image generation tool exactly once. ${COLLECT_RULE} Image description: ${PROMPT}"
fi
if [ -n "$SIZE" ]; then
  INSTRUCTION="${INSTRUCTION} Desired image size: ${SIZE}."
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/codex-imagegen.XXXXXX")" || { err "cannot create a temp folder"; exit 1; }
LOG="$WORK.log"

# A scratch working root and a read-only sandbox: nothing to save into, and the
# user's project stays untouched.
CMD=(codex exec --json -C "$WORK" -s read-only --skip-git-repo-check)
CMD+=("${SERVICE_TIER_ARGS[@]}" -m "$MODEL" -c "model_reasoning_effort=\"$EFFORT\"")
for ABS in "${ABS_REFS[@]:-}"; do
  [ -n "$ABS" ] || continue
  CMD+=(-i "$ABS")
done
# `--` is required, not cosmetic: codex's `-i/--image <FILE>...` is variadic, so
# without it the instruction is parsed as one more image filename and the prompt
# positional ends up empty (codex then blocks reading it from stdin).
CMD+=(-- "$INSTRUCTION")

# --- Run Codex and watch this session's own folder ---------------------------
CODEX_PID=""

stop_codex() {
  [ -n "$CODEX_PID" ] || return 0
  kill -0 "$CODEX_PID" 2>/dev/null || return 0
  if [ -r "/proc/$CODEX_PID/winpid" ] && command -v taskkill >/dev/null 2>&1; then
    # Git Bash: a native codex.exe has children that `kill` would leave running.
    taskkill //PID "$(cat "/proc/$CODEX_PID/winpid")" //T //F >/dev/null 2>&1
  else
    command -v pkill >/dev/null 2>&1 && pkill -P "$CODEX_PID" 2>/dev/null
    kill "$CODEX_PID" 2>/dev/null
  fi
  wait "$CODEX_PID" 2>/dev/null
}

cleanup() { stop_codex; rm -rf "$WORK" "$LOG"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
GEN_DIR="$CODEX_HOME_DIR/generated_images"

# True once the file is a whole PNG, so a half-written image is never copied.
is_complete_png() {
  [ -s "$1" ] \
    && [ "$(head -c 4 "$1" | od -An -tx1 | tr -d ' \n')" = "89504e47" ] \
    && [ "$(tail -c 8 "$1" | od -An -tx1 | tr -d ' \n')" = "49454e44ae426082" ]
}

# The oldest complete PNG in one session's folder. Never looks at another session.
session_image() {
  local f best="" best_mtime="" m
  for f in "$GEN_DIR/$1"/*.png; do
    is_complete_png "$f" || continue
    m="$(mtime "$f")"
    if [ -z "$best" ] || [ "$m" -lt "$best_mtime" ]; then
      best="$f"; best_mtime="$m"
    fi
  done
  printf '%s' "$best"
}

# stdin is closed: on an open pipe, `codex exec` waits for more input forever.
"${CMD[@]}" >"$LOG" 2>&1 </dev/null &
CODEX_PID=$!

START_EPOCH="$(date +%s)"
THREAD=""
IMAGE=""
EXITED_AT=""

while :; do
  NOW="$(date +%s)"
  ELAPSED=$((NOW - START_EPOCH))

  if [ -z "$THREAD" ]; then
    THREAD="$(sed -n 's/.*"type": *"thread\.started".*"thread_id": *"\([A-Za-z0-9_-]*\)".*/\1/p' "$LOG" | head -n 1)"
  fi

  if [ -n "$THREAD" ]; then
    IMAGE="$(session_image "$THREAD")"
    [ -n "$IMAGE" ] && break
  elif [ "$ELAPSED" -gt "$START_TIMEOUT" ]; then
    err "no Codex session after ${START_TIMEOUT}s. Last output:"
    tail -n 5 "$LOG" >&2
    exit 124
  fi

  if [ "$ELAPSED" -gt "$TIMEOUT" ]; then
    err "timed out after ${TIMEOUT}s. Raise --timeout or simplify the prompt."
    exit 124
  fi

  if ! kill -0 "$CODEX_PID" 2>/dev/null; then
    [ -n "$EXITED_AT" ] || EXITED_AT="$NOW"
    if [ $((NOW - EXITED_AT)) -gt 2 ]; then   # let a last image reach the disk
      wait "$CODEX_PID"; CODEX_STATUS=$?
      CODEX_PID=""
      err "image was not produced (codex exit code: ${CODEX_STATUS})."
      err "looked in: ${GEN_DIR}/${THREAD:-<no session>}/"
      err "--- codex output (last 30 lines) ---"
      tail -n 30 "$LOG" >&2
      exit 2
    fi
  fi
  sleep 1
done

stop_codex   # the first image is the result, so a retry cannot spend more quota
CODEX_PID=""

# --- Check the reference reached the tool ------------------------------------
# 0 passed | 1 the call left it out | 2 no image call found in the session log
reference_passed() {
  local log calls n
  for log in "$CODEX_HOME_DIR"/sessions/*/*/*/rollout-*"$THREAD".jsonl; do
    [ -f "$log" ] || continue
    calls="$(grep -E '"type": *"(custom_tool_call|function_call)"' "$log" | grep -E 'image_gen|imagegen' || true)"
    [ -n "$calls" ] || continue
    for n in $(printf '%s\n' "$calls" | grep -oE 'num_last_images_to_include[^0-9]{0,4}[0-9]+' | grep -oE '[0-9]+$' || true); do
      [ "$n" -ge "$N_REFS" ] && return 0
    done
    return 1
  done
  return 2
}

if [ "$N_REFS" -gt 0 ]; then
  reference_passed
  case $? in
    1) err "the image call did not include the reference, so the result ignores it. Nothing saved; retry once. Session image: $IMAGE"
       exit 3 ;;
    2) err "note: could not find the image call in the session log; check the reference was used." ;;
  esac
fi

# --- Write the result --------------------------------------------------------
PARTIAL="$OUTPUT.part.$$"
if ! cp "$IMAGE" "$PARTIAL" || ! mv -f "$PARTIAL" "$OUTPUT"; then
  rm -f "$PARTIAL"
  err "could not write $OUTPUT (the image is at $IMAGE)"
  exit 2
fi

printf '%s\n' "$OUTPUT"
exit 0
